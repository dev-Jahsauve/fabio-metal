# Neon PostgreSQL — server only
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# JWT signing secret — minimum 32 characters, random and private
AUTH_SECRET="replace-with-a-long-random-secret-of-at-least-32-characters"

# Public application URL. Required for payment callbacks in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# FABIOLE METAL WhatsApp number without + or spaces
NEXT_PUBLIC_WHATSAPP="237698308780"

# Delivery: simple initial fixed fee. Use 0 for free pickup/delivery by quote.
DEFAULT_DELIVERY_FEE_XAF="0"

# NelsiusPay — créez un compte marchand sur https://nelsiuspay.com puis
# renseignez la clé secrète (sk_test_... en test, sk_live_... en production).
NELSIUSPAY_API_KEY=""
NELSIUSPAY_MODE="TEST"
# Optionnel : lien de paiement statique créé depuis le dashboard NelsiusPay
# (ex : https://nelsius.com/pay/ma-boutique). Utilisé uniquement si
# NELSIUSPAY_API_KEY est vide : le client paie via ce lien et vous confirmez
# chaque commande manuellement dans /admin après vérification du paiement.
# NELSIUSPAY_PAYMENT_LINK=""

# Cron endpoint used to release expired payment reservations.
CRON_SECRET="replace-with-another-long-random-secret"

# Optional password-reset email delivery through Resend.
# Without these values, development exposes a reset URL only outside production.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="FABIOLE METAL <noreply@your-domain.tld>"

# Google login (optionnel) — créez un Client ID sur https://console.cloud.google.com/
# puis renseignez les deux variables avec la même valeur.
GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
